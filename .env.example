# Added automatically when you attach a Blob store to the Vercel project.
BLOB_READ_WRITE_TOKEN=

# Shared passcode that guards every API route. Set this in the Vercel dashboard.
APP_PASSCODE=

# Only needed for the Android build, where the app is not served from the API's origin.
# Leave this empty for the website and for local development.
VITE_API_BASE=
